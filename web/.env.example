OPENROUTER_API_KEY=

# Override the default in src/lib/openhedge/model.ts
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash

OPENHEDGE_MCP_URL=https://mcp.openhedge.app/mcp

# Per-step / tool / overall generation timeouts (milliseconds)
OPENHEDGE_STEP_TIMEOUT_MS=90000
OPENHEDGE_TOOL_TIMEOUT_MS=40000
OPENHEDGE_TOTAL_TIMEOUT_MS=180000
